{
  "name": "bvqss-desktop",
  "private": true,
  "version": "1.0.0",
  "description": "Windows and Mac apps for BVQSS Tender, BVQSS Value, BVQSS Damage and BVQSS HSE",
  "author": "BVQSS <office@bvqss.com>",
  "homepage": "https://bvqss.com",
  "main": "src/main.js",
  "type": "commonjs",
  "scripts": {
    "start": "node scripts/prepare.mjs tender && electron .",
    "start:value": "node scripts/prepare.mjs value && electron .",
    "start:damage": "node scripts/prepare.mjs damage && electron .",
    "start:hse": "node scripts/prepare.mjs hse && electron .",
    "dist": "electron-builder --config build/builder.json --publish never"
  },
  "dependencies": {
    "electron-updater": "6.8.11"
  },
  "devDependencies": {
    "electron": "45.5.0",
    "electron-builder": "26.18.0",
    "sharp": "0.35.5"
  },
  "overrides": {
    "minimatch@>=7.0.0 <11.0.1": "11.0.9"
  }
}
